{
  "description": "tp session hooks: preflight and orient at SessionStart, hold the unit scope fence on writes, claim a brief's task when an agent is spawned with it, refuse a sub-agent's stop while a task it claimed is neither done nor waiting, refuse a role unit's stop before it has written its findings, and ask a coordinator whose turn ends with free parallel slots to fill them",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|mcp__codedbpro__create|mcp__codedbpro__edit|mcp__codedbpro__patch|mcp__codedbpro__replace|mcp__codedbpro__batch",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-write-deny.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-agent-claim.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-role-incomplete.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-fill-pool.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subagent-stop-claim.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": ["./run-panel.tsx"]
}
