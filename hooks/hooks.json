{
  "description": "tp session hooks: preflight and orient at SessionStart, hold the unit scope fence on writes, and refuse a role unit's stop before it has written its findings",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|mcp__codedbpro__create|mcp__codedbpro__edit|mcp__codedbpro__patch|mcp__codedbpro__replace",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-write-deny.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-role-incomplete.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
