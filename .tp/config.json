{
  "workflow": {
    "quality_gate": "./scripts/check-suite-state.sh \u0026\u0026 golangci-lint run \u0026\u0026 ./scripts/check-deadcode.sh \u0026\u0026 ./scripts/check-complexity.sh",
    "review_clean_rounds": 2,
    "audit_clean_rounds": 2,
    "checks": [
      {
        "class": "code-citation-drift",
        "cmd": "python3 scripts/check-spec-code-citations.py \"${TP_SPEC:?}\""
      },
      {
        "class": "method-only-in-ungraded-sidecar",
        "cmd": "python3 scripts/check-test-rows-cite-sidecar.py \"${TP_SPEC:?}\""
      },
      {
        "class": "spec-growth",
        "cmd": "python3 scripts/check-spec-growth.py \"${TP_SPEC:?}\""
      }
    ],
    "task_audit_roles": [
      "go-safety"
    ],
    "run_max_parallel": 4,
    "run_max_parallel_gates": 2
  }
}
